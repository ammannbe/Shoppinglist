APP_NAME=Shoppinglist
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=de_CH
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=shoppinglist
DB_USERNAME=shoppinglist
DB_PASSWORD=

# Old Laravel 7 API database, only for `php artisan shoppinglist:import-legacy`
# LEGACY_DB_HOST=127.0.0.1
# LEGACY_DB_DATABASE=legacy
# LEGACY_DB_USERNAME=
# LEGACY_DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# AI assistant (offers, pantry, recipe suggestions); empty = feature hidden
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
OPENAI_REASONING_EFFORT=low

# Recipe app connection (OAuth client created in the recipe app, redirect URI: ${APP_URL}/recipes/callback)
RECIPES_NAME=RecipeManager
RECIPES_URL=
RECIPES_CLIENT_ID=
RECIPES_CLIENT_SECRET=

# Login (see config/login.php)
AUTH_LOCAL_ENABLED=true
AUTH_LOCAL_REGISTRATION=true
AUTH_LOCAL_EMERGENCY_EMAILS=
AUTH_OIDC_ENABLED=false
AUTH_OIDC_LABEL=
AUTH_OIDC_SIGNUP_URL=
AUTH_OIDC_ISSUER=
AUTH_OIDC_CLIENT_ID=
AUTH_OIDC_CLIENT_SECRET=
AUTH_OIDC_REGISTRATION=true
AUTH_OIDC_REQUIRED_GROUP=

# Households (see config/households.php): local = managed in this app, konto = mirrored from the AccountManager (read only here, needs OIDC).
# konto: webhook URL in the AccountManager <APP_URL>/api/konto/webhook, one secret for webhooks and API.
HOUSEHOLDS_DRIVER=local
KONTO_URL=
KONTO_SERVICE_KEY=
KONTO_SECRET=
KONTO_REPORT_SHARES=true
